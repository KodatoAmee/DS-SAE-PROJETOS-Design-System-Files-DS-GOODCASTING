{
  "name": "ds-goodcasting",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "DS-GoodCasting: design system da Good Casting (React + Tailwind v4 + Storybook). Estrutura do DS-Zara, identidade do brandbook Good Casting.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./theme.css": "./src/styles/theme.css",
    "./styles.css": "./dist/lib/ds-goodcasting.css",
    "./tokens.json": "./tokens/tokens.json"
  },
  "files": [
    "dist/lib",
    "src/styles",
    "tokens"
  ],
  "scripts": {
    "dev": "storybook dev -p 6017 --ci --config-dir .storybook",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build-storybook": "storybook build --config-dir .storybook -o storybook-static",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
