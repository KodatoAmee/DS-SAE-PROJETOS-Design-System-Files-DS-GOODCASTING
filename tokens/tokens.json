  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "Arial", "sans-serif"], "$description": "CASTING: clareza, modernidade. Todo o texto de interface." },
      "display": { "$type": "fontFamily", "$value": ["Playfair Display", "Georgia", "Times New Roman", "serif"], "$description": "GOOD: sofisticação, autoridade. Só títulos editoriais." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500, "$description": "Ações e item selecionado." },
      "semibold": { "$value": 600, "$description": "Títulos em Inter." }
