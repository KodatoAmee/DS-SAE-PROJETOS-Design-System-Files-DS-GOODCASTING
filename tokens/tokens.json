    "$type": "shadow",
    "card": { "$value": { "offsetX": "0px", "offsetY": "2px", "blur": "8px", "spread": "0px", "color": "rgba(0, 0, 0, 0.1)" } },
    "overlay": { "$value": { "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px", "color": "rgba(0, 0, 0, 0.16)" } }
  },
